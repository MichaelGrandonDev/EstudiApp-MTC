/* EstudiApp MTC: papel cálido, tinta, jade, bermellón y oro.
   Espaciado 4 · 8 · 12 · 16 · 24 · 32 px. Radios 8 · 12 · 16 · píldora.
   Raíz con .wide (barra lateral) o .narrow (pestañas abajo, móvil). */
:root {
    --paper: rgb(246, 241, 231);
    --card: rgb(255, 253, 248);
    --ink: rgb(43, 38, 34);
    --muted: rgb(122, 112, 102);
    --line: rgb(226, 216, 200);
    --line-soft: rgba(120, 100, 70, 0.12);
    --jade: rgb(46, 125, 107);
    --jade-deep: rgb(30, 92, 78);
    --jade-wash: rgba(46, 125, 107, 0.12);
    --cinnabar: rgb(181, 82, 59);
    --gold: rgb(201, 154, 46);
    --gold-text: rgb(140, 102, 20);
    --gold-wash: rgba(201, 154, 46, 0.14);
    --night: rgb(36, 42, 51);
    --ok: rgb(62, 142, 90);
    --bad: rgb(178, 58, 72);
    -unity-font-definition: resource("UI/Fonts/Outfit-Regular");
}

.root {
    -unity-font-definition: resource("UI/Fonts/Outfit-Regular");
    background-color: var(--paper);
    color: var(--ink);
    font-size: 15px;
}

/* Solo una clase: así los márgenes de .section-title, .card__title, etc. pueden sobrescribirlo. */
.unity-label {
    margin: 0;
    padding: 0;
    white-space: normal;
}

.hidden { display: none; }
.row { flex-direction: row; align-items: center; }
.spacer { flex-grow: 1; }
.muted { color: var(--muted); font-size: 13px; }

.hanzi { -unity-font-definition: resource("UI/Fonts/NotoSansSC-Subset"); }
.hide-hanzi .hanzi, .hide-hanzi .hanzi-line, .hide-hanzi .detail__hanzi, .hide-hanzi .dnode__hanzi { display: none; }

/* ---------- Carga ---------- */
.loading {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--paper);
}
.loading__logo { width: 84px; height: 84px; margin-bottom: 16px; }
.loading__title { font-size: 30px; color: var(--ink); -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.loading__text { font-size: 14px; color: var(--muted); margin-top: 6px; -unity-text-align: middle-center; max-width: 420px; }
.loading__credit { position: absolute; bottom: 28px; font-size: 13px; color: var(--muted); letter-spacing: 0.4px; }

/* ---------- Créditos ---------- */
.nav__credit { flex-direction: column; align-items: flex-start; margin: 10px 0 0 0; padding: 10px 12px; border-radius: 10px; border-top-width: 1px; border-color: rgba(250, 246, 236, 0.12); }
.nav__credit:hover { background-color: rgba(255, 255, 255, 0.07); }
.nav__credit-label { font-size: 10px; color: rgba(250, 246, 236, 0.55); letter-spacing: 0.6px; }
.nav__credit-name { font-size: 13px; color: rgb(250, 246, 236); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.narrow .nav__credit { display: none; }
.home-credit { flex-direction: column; align-items: center; margin: 28px 0 0 0; padding: 12px; border-radius: 12px; }
.home-credit:hover { background-color: var(--jade-wash); }
.home-credit__text { font-size: 13px; color: var(--muted); -unity-text-align: middle-center; }
.home-credit__url { font-size: 12px; color: var(--jade-deep); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.credit { margin: 6px 0 12px 0; padding: 12px 14px; max-width: 520px; border-radius: 14px; background-color: var(--card); border-width: 1px; border-color: var(--line); }
.credit__logo { width: 34px; height: 34px; margin-right: 12px; }
.credit__label { font-size: 12px; color: var(--muted); }
.credit__name { font-size: 18px; color: var(--ink); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.dialog__credit { font-size: 13px; color: var(--muted); margin-top: 10px; }

/* ---------- Marco ---------- */
.app { flex-grow: 1; flex-direction: row; opacity: 0; }
.app--ready { opacity: 1; }

.nav {
    width: 216px;
    background-color: var(--night);
    padding: 16px 12px;
    flex-shrink: 0;
}
.nav__brand { flex-direction: row; align-items: center; margin: 0 4px 22px 4px; }
.nav__logo { width: 38px; height: 38px; margin-right: 10px; }
.nav__name { font-size: 22px; color: rgb(250, 246, 236); -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.nav__tagline { font-size: 10px; color: rgba(250, 246, 236, 0.6); letter-spacing: 0.4px; }
.nav__btn {
    flex-direction: row;
    justify-content: flex-start;
    width: auto;
    height: 42px;
    margin-bottom: 4px;
    padding: 0 12px;
    border-radius: 10px;
}
.nav__btn .icon { color: rgba(250, 246, 236, 0.72); width: 20px; height: 20px; }
.nav__btn .icon-btn__label { color: rgba(250, 246, 236, 0.82); font-size: 14px; margin-left: 12px; }
.nav__btn:hover { background-color: rgba(255, 255, 255, 0.07); }
.nav__btn:hover .icon, .nav__btn:hover .icon-btn__label { color: rgb(255, 255, 255); }
.nav__btn--on, .nav__btn--on:hover { background-color: rgba(46, 125, 107, 0.55); }
.nav__btn--on .icon, .nav__btn--on .icon-btn__label { color: rgb(255, 255, 255); }
.badge {
    position: absolute;
    right: 10px;
    top: 11px;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    background-color: var(--gold);
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold");
}

.main { flex-grow: 1; flex-shrink: 1; }
.topbar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 0 16px;
    border-bottom-width: 1px;
    border-color: var(--line);
    background-color: rgba(246, 241, 231, 0.96);
}
.topbar__title { font-size: 17px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); flex-shrink: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-left: 4px; }
.topbar__back { margin-right: 4px; }
.stage { flex-grow: 1; flex-shrink: 1; }
.page-scroll { flex-grow: 1; }
.page-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { align-items: center; }
.page { width: 100%; max-width: 1020px; padding: 24px 32px 48px 32px; }
.page--diagram { max-width: 1100px; }

.wide .topbar__btn--narrow { display: none; }
.wide .topbar__btn { display: none; }

/* Móvil: pestañas abajo. */
.narrow .app { flex-direction: column-reverse; }
.narrow .nav {
    width: auto;
    height: 64px;
    flex-direction: row;
    padding: 4px 4px 6px 4px;
    justify-content: space-around;
    background-color: var(--card);
    border-top-width: 1px;
    border-color: var(--line);
}
.narrow .nav__brand, .narrow .nav__spacer, .narrow .nav__btn--secondary { display: none; }
.narrow .nav__btn {
    flex-direction: column;
    justify-content: center;
    height: 54px;
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 2px;
    padding: 0;
}
.narrow .nav__btn .icon { color: var(--muted); width: 22px; height: 22px; }
.narrow .nav__btn .icon-btn__label { color: var(--muted); font-size: 10px; margin: 3px 0 0 0; }
.narrow .nav__btn--on, .narrow .nav__btn--on:hover { background-color: var(--jade-wash); }
.narrow .nav__btn--on .icon, .narrow .nav__btn--on .icon-btn__label { color: var(--jade-deep); }
.narrow .badge { right: 12%; top: 2px; }
.narrow .page { padding: 16px 16px 40px 16px; }
.narrow .topbar { height: 50px; padding: 0 8px; }

/* ---------- Botones ---------- */
.icon { width: 20px; height: 20px; flex-shrink: 0; color: var(--ink); --icon-stroke: 1.8; }

.icon-btn, .btn, .chip, .option, .ref-btn, .search-hit, .reader__page, .nav__credit, .home-credit {
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color, scale, opacity;
    transition-duration: 0.14s;
}
.icon-btn {
    width: 38px;
    height: 38px;
    padding: 0;
    border-radius: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.icon-btn:hover { background-color: var(--jade-wash); }
.icon-btn:active { scale: 0.94 0.94; }
.icon-btn--label { width: auto; padding: 0 14px 0 10px; }
.icon-btn__label { font-size: 14px; margin-left: 6px; color: var(--ink); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.icon-btn--small { width: 34px; height: 34px; }
.icon-btn--on { background-color: var(--jade); }
.icon-btn--on .icon { color: rgb(255, 255, 255); }
.icon-btn:disabled { opacity: 0.35; }

.btn {
    height: 42px;
    padding: 0 20px;
    border-radius: 21px;
    background-color: var(--jade);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold");
    -unity-text-align: middle-center;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.btn .icon, .btn .icon-btn__label { color: rgb(255, 255, 255); }
.btn:hover { background-color: var(--jade-deep); }
.btn:active { scale: 0.97 0.97; }
.btn:disabled { opacity: 0.4; }
.btn--small { height: 34px; padding: 0 14px; font-size: 13px; border-radius: 17px; }
.btn--ghost { background-color: rgba(0, 0, 0, 0); color: var(--jade-deep); border-width: 1px; border-color: var(--line); }
.btn--ghost .icon, .btn--ghost .icon-btn__label { color: var(--jade-deep); }
.btn--ghost:hover { background-color: var(--jade-wash); }
.icon-btn.btn--ghost { border-width: 0; }
.btn--gold { background-color: var(--gold); }
.btn--gold:hover { background-color: var(--gold-text); }
.btn--danger { background-color: var(--bad); align-self: flex-start; }
.btn--danger:hover { background-color: rgb(140, 40, 52); }

.chips { flex-direction: row; flex-wrap: wrap; margin: 8px 0; }
.chip {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    margin: 0 6px 6px 0;
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--card);
}
.chip:hover { background-color: var(--jade-wash); }
.chip__dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 7px; }
.chip__label { font-size: 13px; color: var(--ink); }
.chip--on { background-color: var(--night); border-color: var(--night); }
.chip--on:hover { background-color: var(--night); }
.chip--on .chip__label { color: rgb(255, 255, 255); }

.pill {
    align-self: flex-start;
    padding: 4px 10px;
    margin: 6px 0;
    border-radius: 12px;
    background-color: var(--line-soft);
    color: var(--muted);
    font-size: 12px;
    -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold");
}
.pill--gold { background-color: var(--gold-wash); color: var(--gold-text); }
.pill--jade { background-color: var(--jade-wash); color: var(--jade-deep); }

.bar { height: 6px; border-radius: 3px; background-color: var(--line); overflow: hidden; }
.bar__fill { height: 100%; border-radius: 3px; transition-property: width; transition-duration: 0.8s; transition-timing-function: ease-out-cubic; }

/* ---------- Textos de página ---------- */
.page-title { font-size: 34px; color: var(--ink); -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); margin-bottom: 6px; }
.page-lead { font-size: 15px; color: var(--muted); margin-bottom: 12px; max-width: 760px; }
.section-title { font-size: 13px; color: var(--muted); letter-spacing: 1px; margin: 26px 0 10px 0; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.subsection-title { font-size: 20px; margin: 18px 0 8px 0; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.page-head { align-items: flex-start; }
.page-head__text { flex-shrink: 1; flex-grow: 1; margin-right: 16px; }
.narrow .page-title { font-size: 28px; }
.narrow .page-head { flex-direction: column; }

/* ---------- Tarjetas ---------- */
.card {
    background-color: var(--card);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 4px;
    padding: 18px 20px;
    margin-bottom: 14px;
}
.card--action:hover { border-color: rgb(205, 192, 170); }
.card__eyebrow { font-size: 12px; letter-spacing: 0.8px; margin-bottom: 4px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.card__title { font-size: 22px; margin-bottom: 6px; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.card__text { font-size: 14px; color: var(--muted); }
.card__footer { flex-direction: row; align-items: center; margin-top: 14px; }
.hanzi-line { font-size: 16px; color: var(--muted); margin-bottom: 6px; -unity-font-definition: resource("UI/Fonts/NotoSansSC-Subset"); }

/* ---------- Inicio ---------- */
.hero { flex-direction: row; align-items: center; margin-bottom: 16px; }
.hero__text { flex-grow: 1; flex-shrink: 1; margin-right: 16px; }
.hero__date { font-size: 13px; color: var(--muted); }
.hero__title { font-size: 40px; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.hero__text-body { font-size: 15px; color: var(--muted); max-width: 560px; }
.hero__ring { width: 120px; height: 120px; flex-shrink: 0; }
.narrow .hero__ring { width: 88px; height: 88px; }
.narrow .hero__title { font-size: 30px; }

.progress-ring { align-items: center; justify-content: center; }
.progress-ring__label { font-size: 22px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.progress-ring__caption { font-size: 11px; color: var(--muted); }
.axis-hero .progress-ring__label { color: rgb(255, 255, 255); }

.stats { flex-direction: row; flex-wrap: wrap; margin: 0 -6px 12px -6px; }
.stat {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 180px;
    margin: 6px;
    padding: 12px 14px;
    border-radius: 14px;
    background-color: var(--card);
    border-width: 1px;
    border-color: var(--line);
}
.stat .icon { width: 26px; height: 26px; margin-right: 12px; --icon-stroke: 2; }
.stat__value { font-size: 20px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.stat__label { font-size: 12px; color: var(--muted); }
.narrow .stat { flex-basis: 40%; }

.home-grid { flex-direction: row; flex-wrap: wrap; margin: 0 -7px; }
.home-grid__col { flex-grow: 1; flex-basis: 360px; margin: 0 7px; }
.featured__canvas { max-width: 380px; align-self: center; }

/* ---------- Ruta y ejes ---------- */
.path__level { font-size: 13px; color: var(--muted); letter-spacing: 1px; margin: 22px 0 10px 0; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.axis-card {
    flex-direction: row;
    align-items: center;
    background-color: var(--card);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 5px;
    padding: 14px 18px;
    margin-bottom: 10px;
    transition-property: translate, border-color;
    transition-duration: 0.15s;
}
.axis-card:hover { translate: 3px 0; border-color: rgb(205, 192, 170); }
.axis-card__hanzi { font-size: 34px; width: 84px; -unity-text-align: middle-center; margin-right: 14px; }
.axis-card__body { flex-grow: 1; flex-shrink: 1; }
.axis-card__head { flex-direction: row; align-items: center; }
.axis-card__title { font-size: 21px; flex-shrink: 1; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.axis-card__subtitle { font-size: 13px; color: var(--muted); margin: 2px 0 6px 0; }
.axis-card__bar { margin: 8px 0 6px 0; }
.axis-card__meta { font-size: 12px; color: var(--muted); }
.axis-card--locked { opacity: 0.72; }
.axis-card--soon { opacity: 0.55; border-left-color: var(--line); }
.axis-card--soon:hover { translate: 0 0; }
.axis-card--soon .axis-card__hanzi { color: var(--muted); }
.axis-card--compact { padding: 10px 14px; }
.axis-card--compact .axis-card__hanzi { font-size: 26px; width: 60px; }
.narrow .axis-card__hanzi { font-size: 26px; width: 56px; margin-right: 10px; }

.axis-hero {
    flex-direction: row;
    align-items: center;
    border-radius: 20px;
    padding: 24px 28px;
    margin-bottom: 16px;
}
.axis-hero__hanzi { font-size: 56px; color: rgba(255, 255, 255, 0.92); margin-right: 20px; }
.axis-hero__text { flex-grow: 1; flex-shrink: 1; }
.axis-hero__pinyin { font-size: 14px; color: rgba(255, 255, 255, 0.75); letter-spacing: 1px; }
.axis-hero__title { font-size: 34px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.axis-hero__subtitle { font-size: 14px; color: rgba(255, 255, 255, 0.82); }
.axis-hero__ring { width: 92px; height: 92px; flex-shrink: 0; }
.narrow .axis-hero { padding: 18px; }
.narrow .axis-hero__hanzi { font-size: 38px; margin-right: 12px; }
.narrow .axis-hero__title { font-size: 26px; }
.narrow .axis-hero__ring { width: 64px; height: 64px; }

.lesson-list { background-color: var(--card); border-radius: 16px; border-width: 1px; border-color: var(--line); overflow: hidden; }
.lesson-row {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    border-bottom-width: 1px;
    border-color: var(--line-soft);
    transition-property: background-color;
    transition-duration: 0.12s;
}
.lesson-row:hover { background-color: var(--jade-wash); }
.lesson-row__badge {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 2px;
    border-color: var(--line);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    flex-shrink: 0;
}
.lesson-row__badge .icon { width: 18px; height: 18px; color: var(--muted); }
.lesson-row--completed .lesson-row__badge { border-width: 0; }
.lesson-row--completed .lesson-row__badge .icon { color: rgb(255, 255, 255); }
.lesson-row__number { font-size: 14px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.lesson-row__body { flex-grow: 1; flex-shrink: 1; }
.lesson-row__title { font-size: 16px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.lesson-row__meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
.lesson-row__hanzi { font-size: 18px; color: var(--muted); margin: 0 10px; }
.lesson-row__chevron { color: var(--muted); width: 16px; height: 16px; }
.lesson-row--locked, .lesson-row--premiumlocked { opacity: 0.55; }
.narrow .lesson-row__hanzi { display: none; }

.callout {
    flex-direction: row;
    align-items: flex-start;
    border-radius: 14px;
    padding: 14px 16px;
    margin: 12px 0;
    background-color: var(--line-soft);
}
.callout > .icon { margin: 2px 12px 0 0; }
.callout__body { flex-grow: 1; flex-shrink: 1; }
.callout__title { font-size: 13px; letter-spacing: 0.6px; margin-bottom: 4px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.callout__text { font-size: 15px; flex-shrink: 1; }
.callout--note { background-color: var(--gold-wash); }
.callout--note .icon, .callout--note .callout__title { color: var(--gold-text); }
.callout--clinical { background-color: rgba(181, 82, 59, 0.1); }
.callout--clinical .icon, .callout--clinical .callout__title { color: var(--cinnabar); }
.callout--lock .icon { color: var(--muted); }

/* ---------- Lección ---------- */
.lesson { max-width: 820px; align-self: center; width: 100%; }
.lesson__head { margin-bottom: 16px; }
.lesson__crumb { font-size: 13px; letter-spacing: 0.6px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.lesson__title { font-size: 40px; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); margin: 4px 0; }
.lesson__hanzi-line { margin-bottom: 6px; }
.lesson__hanzi { font-size: 28px; margin-right: 12px; }
.lesson__pinyin { font-size: 17px; color: var(--muted); }
.narrow .lesson__title { font-size: 30px; }

.summary { background-color: var(--card); border-radius: 14px; border-width: 1px; border-color: var(--line); border-left-width: 4px; padding: 16px 18px; margin-bottom: 8px; }
.summary__label { font-size: 12px; letter-spacing: 0.8px; margin-bottom: 4px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.summary__text { font-size: 18px; }

.block { margin-top: 14px; }
.block__title { font-size: 24px; margin: 16px 0 8px 0; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.paragraph { font-size: 16px; }
.bullet { align-items: flex-start; margin: 4px 0; }
.bullet__dot { width: 6px; height: 6px; border-radius: 3px; background-color: var(--jade); margin: 9px 12px 0 4px; flex-shrink: 0; }
.bullet__text { font-size: 16px; flex-shrink: 1; }
.table { border-radius: 12px; border-width: 1px; border-color: var(--line); overflow: hidden; background-color: var(--card); }
.table__row { align-items: stretch; border-bottom-width: 1px; border-color: var(--line-soft); }
.table__row--head { background-color: var(--night); }
.table__row--head .table__cell { color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); font-size: 13px; }
.table__cell { flex-grow: 1; flex-basis: 0; flex-shrink: 1; padding: 8px 10px; font-size: 14px; }
.quote { background-color: var(--card); border-radius: 14px; padding: 16px 20px 12px 44px; border-width: 1px; border-color: var(--line); }
.quote__mark { position: absolute; left: 12px; top: 0; font-size: 54px; color: var(--gold); -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.quote__text { font-size: 18px; -unity-font-style: italic; margin-bottom: 8px; }

.keypoints { background-color: var(--jade-wash); border-radius: 16px; padding: 16px 18px; margin-top: 22px; }
.keypoints__title { font-size: 22px; margin-bottom: 8px; color: var(--jade-deep); -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.keypoints__item { align-items: flex-start; margin: 4px 0; }
.keypoints__item .icon { width: 18px; height: 18px; margin: 2px 10px 0 0; }
.keypoints__text { font-size: 15px; flex-shrink: 1; }

.terms { background-color: var(--card); border-radius: 14px; border-width: 1px; border-color: var(--line); }
.term { flex-direction: row; align-items: center; padding: 10px 14px; border-bottom-width: 1px; border-color: var(--line-soft); }
.term__hanzi { font-size: 26px; width: 84px; flex-shrink: 0; -unity-text-align: middle-center; margin-right: 12px; }
.term__body { flex-grow: 1; flex-shrink: 1; }
.term__name { font-size: 15px; }
.term__definition { font-size: 13px; color: var(--muted); }

.refs { margin-top: 6px; }
.ref-btn {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    padding: 6px 12px 6px 8px;
    margin: 4px 0;
    border-radius: 10px;
    background-color: var(--gold-wash);
}
.ref-btn:hover { background-color: rgba(201, 154, 46, 0.26); }
.ref-btn .icon { width: 16px; height: 16px; color: var(--gold-text); margin-right: 8px; }
.ref-btn__text { font-size: 13px; color: var(--ink); flex-shrink: 1; }

.note-field { margin: 0; min-height: 110px; }
.note-field > .unity-text-field__input, .search-field > .unity-text-field__input {
    background-color: var(--card);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--line);
    padding: 10px 12px;
    font-size: 15px;
    color: var(--ink);
    -unity-font-definition: resource("UI/Fonts/Outfit-Regular");
}
.note-field > .unity-text-field__input { min-height: 110px; -unity-text-align: upper-left; white-space: normal; }
.search-field { margin: 0 0 12px 0; }
.search-field--big > .unity-text-field__input { font-size: 18px; padding: 14px 16px; border-radius: 16px; }

.lesson__footer { margin-top: 26px; padding-top: 18px; border-top-width: 1px; border-color: var(--line); }
.lesson__actions { flex-direction: row; align-items: center; flex-wrap: wrap; margin: 8px 0; }
.lesson__nav { flex-direction: row; align-items: center; margin-top: 14px; }
.lesson__nav-btn { max-width: 48%; height: auto; min-height: 40px; padding: 6px 12px; }
.lesson__nav-btn .icon-btn__label { color: var(--muted); font-size: 13px; -unity-font-definition: resource("UI/Fonts/Outfit-Regular"); white-space: normal; flex-shrink: 1; }
.lesson__nav-btn--next { flex-direction: row; border-width: 0; }
.lesson__nav-btn--next .icon-btn__label { margin: 0 6px 0 0; -unity-text-align: middle-right; }
.lesson__nav-btn--next .icon { color: var(--muted); }

/* ---------- Diagramas ---------- */
.diagram {
    background-color: var(--card);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--line);
    padding: 16px 18px;
    margin: 18px 0;
}
.diagram__header { flex-direction: row; align-items: center; margin-bottom: 4px; }
.diagram__icon { color: var(--jade); margin-right: 8px; }
.diagram__title { font-size: 22px; flex-shrink: 1; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.diagram__intro { font-size: 14px; color: var(--muted); margin-bottom: 8px; }
.diagram__hint { font-size: 11px; color: var(--muted); margin-top: 6px; -unity-text-align: middle-center; }
.diagram__refs { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 8px; }
.diagram__refs-title { font-size: 12px; color: var(--muted); margin-right: 8px; }
.diagram__refs .ref-btn { margin-right: 6px; }
.diagram--full { padding: 20px 24px; }
.diagram--full .diagram-canvas { max-width: 760px; }

.diagram-canvas { width: 100%; max-width: 640px; align-self: center; overflow: hidden; }
.gallery__canvas, .featured__canvas { max-width: none; }

.dnode {
    position: absolute;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    padding: 2px;
    transition-property: opacity, scale;
    transition-duration: 0.18s;
}
.dnode--rect { border-radius: 10px; }
.dnode:hover { scale: 1.05 1.05; }
.dnode--selected { scale: 1.08 1.08; }
.dnode__hanzi { -unity-font-definition: resource("UI/Fonts/NotoSansSC-Subset"); -unity-text-align: middle-center; }
.dnode__label { -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.dnode__sub { -unity-text-align: middle-center; opacity: 0.75; }
.dedge-label {
    padding: 1px 6px;
    border-radius: 6px;
    background-color: rgba(255, 253, 248, 0.92);
    -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold");
    white-space: nowrap;
}
.dlabel { -unity-text-align: middle-center; }
.ring-label { color: var(--ink); white-space: nowrap; }
.ring-hour { color: var(--muted); }
.ring-center { color: var(--ink); }
.balance-label { -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); white-space: nowrap; }
.balance-normal { color: var(--muted); white-space: nowrap; }
.balance-sliders { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.balance-slider { flex-grow: 1; flex-basis: 240px; margin: 4px 10px 4px 0; }
.balance-slider > Label { min-width: 52px; font-size: 14px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.balance-slider--yin > Label { color: rgb(63, 90, 122); }
.balance-slider--yang > Label { color: rgb(212, 106, 58); }
.tongue-label { color: var(--ink); }

.unity-slider .unity-base-slider__tracker { background-color: var(--line); border-width: 0; border-radius: 3px; height: 6px; top: 50%; margin-top: -3px; }
.unity-slider .unity-base-slider__dragger { background-color: var(--jade); border-color: rgb(255, 255, 255); border-width: 2px; border-radius: 10px; width: 20px; height: 20px; top: 50%; margin-top: -10px; }

/* Barras de desplazamiento finas (el Scroller usa un Slider por dentro: hay que deshacer la regla anterior). */
.unity-scroller { border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroller--vertical { width: 10px; }
.unity-scroller--horizontal { height: 10px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-scroller .unity-base-slider__tracker { position: absolute; left: 0; right: 0; top: 0; bottom: 0; width: auto; height: auto; margin: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroller .unity-base-slider__dragger { background-color: rgba(43, 38, 34, 0.22); border-width: 0; border-radius: 4px; margin: 0; }
.unity-scroller .unity-base-slider__dragger:hover { background-color: rgba(43, 38, 34, 0.38); }
.unity-scroller--vertical .unity-base-slider__dragger { width: 6px; margin-left: 2px; }
.unity-scroller--horizontal .unity-base-slider__dragger { height: 6px; margin-top: 2px; }
.unity-scroller .unity-base-slider__dragger-border { display: none; }
.narrow .unity-scroller--vertical { width: 6px; }
.narrow .unity-scroller--vertical .unity-base-slider__dragger { width: 4px; margin-left: 1px; }

.tour { background-color: var(--paper); border-radius: 14px; padding: 12px 14px; margin-top: 10px; }
.tour__head { flex-direction: row; align-items: center; }
.tour__icon { color: var(--jade); width: 16px; height: 16px; margin-right: 8px; }
.tour__title, .tour__count { font-size: 14px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.tour__step-title { font-size: 19px; margin: 8px 0 4px 0; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.tour__text { font-size: 15px; }
.tour__nav { flex-direction: row; align-items: center; margin-top: 10px; }

.detail {
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 5px;
    background-color: rgb(255, 255, 255);
    padding: 12px 14px;
    margin-top: 10px;
}
.detail__head { flex-direction: row; align-items: center; }
.detail__hanzi { font-size: 26px; margin-right: 10px; -unity-font-definition: resource("UI/Fonts/NotoSansSC-Subset"); }
.detail__title { font-size: 20px; flex-shrink: 1; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.detail__text { font-size: 15px; margin: 4px 0 6px 0; }

.gallery { flex-direction: row; flex-wrap: wrap; margin: 6px -8px; }
.gallery__item {
    flex-basis: 280px;
    flex-grow: 1;
    max-width: 480px;
    margin: 8px;
    padding: 12px;
    border-radius: 16px;
    background-color: var(--card);
    border-width: 1px;
    border-color: var(--line);
    transition-property: translate, border-color;
    transition-duration: 0.15s;
}
.gallery__item:hover { translate: 0 -3px; border-color: rgb(205, 192, 170); }
.gallery__title { font-size: 18px; margin-top: 8px; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.gallery__meta { font-size: 12px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.narrow .gallery__item { flex-basis: 100%; max-width: none; }

/* ---------- Preguntas ---------- */
.quiz { max-width: 720px; width: 100%; align-self: center; }
.quiz__lesson { font-size: 13px; letter-spacing: 0.6px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.quiz__top { flex-direction: row; align-items: center; margin: 6px 0; }
.quiz__count { font-size: 14px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.quiz__bar { margin-bottom: 18px; }
.quiz__next { align-self: flex-end; margin-top: 14px; }
.quiz__footer { flex-direction: row; align-items: center; margin-top: 14px; }

.question__prompt { font-size: 24px; margin-bottom: 6px; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.question__hint { font-size: 13px; color: var(--muted); margin-bottom: 4px; }
.question__options { margin-top: 10px; }
.question__options--row { flex-direction: row; }
.question__options--row .option { flex-grow: 1; flex-basis: 0; margin-right: 10px; }
.option {
    flex-direction: row;
    align-items: center;
    min-height: 50px;
    padding: 10px 14px;
    margin-bottom: 8px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: var(--line);
    background-color: var(--card);
    -unity-text-align: middle-left;
}
.option:hover { border-color: var(--jade); }
.option__mark { width: 18px; height: 18px; border-radius: 9px; border-width: 2px; border-color: var(--line); margin-right: 12px; flex-shrink: 0; }
.option__text { font-size: 16px; flex-shrink: 1; color: var(--ink); }
.option--chosen { border-color: var(--jade); background-color: var(--jade-wash); }
.option--chosen .option__mark { border-color: var(--jade); background-color: var(--jade); }
.option--locked:hover { border-color: var(--line); }
.option--right, .option--right:hover { border-color: var(--ok); background-color: rgba(62, 142, 90, 0.12); }
.option--right .option__mark { border-color: var(--ok); background-color: var(--ok); }
.option--wrong, .option--wrong:hover { border-color: var(--bad); background-color: rgba(178, 58, 72, 0.1); }
.option--wrong .option__mark { border-color: var(--bad); background-color: var(--bad); }
.question__check { align-self: flex-end; margin-top: 6px; }

.feedback { border-radius: 14px; padding: 12px 16px; margin-top: 6px; }
.feedback--ok { background-color: rgba(62, 142, 90, 0.12); }
.feedback--bad { background-color: rgba(178, 58, 72, 0.1); }
.feedback__head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.feedback__head .icon { margin-right: 8px; }
.feedback--ok .icon, .feedback--ok .feedback__title { color: var(--ok); }
.feedback--bad .icon, .feedback--bad .feedback__title { color: var(--bad); }
.feedback__title { font-size: 16px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.feedback__text { font-size: 15px; }

.result { align-items: center; max-width: 620px; align-self: center; padding-top: 20px; }
.result__ring { width: 140px; height: 140px; margin-bottom: 16px; }
.result__title { font-size: 32px; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.result__text { font-size: 15px; color: var(--muted); -unity-text-align: middle-center; margin: 8px 0 12px 0; }
.result .pill { align-self: center; }
.result__actions { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 16px; }
.result__actions .btn { margin: 4px 6px; }

.boxes { flex-direction: row; flex-wrap: wrap; margin: 6px -5px 14px -5px; }
.box { flex-grow: 1; flex-basis: 120px; margin: 5px; padding: 12px; border-radius: 14px; background-color: var(--card); border-width: 1px; border-color: var(--line); }
.box__count { font-size: 24px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.box__label { font-size: 12px; color: var(--muted); margin-bottom: 8px; }

/* ---------- Biblioteca y lector ---------- */
.empty { align-items: center; padding: 28px; border-radius: 16px; border-width: 1px; border-color: var(--line); background-color: var(--card); }
.empty .icon { width: 36px; height: 36px; color: var(--muted); margin-bottom: 8px; }
.empty__title { font-size: 17px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.empty__text { font-size: 14px; color: var(--muted); -unity-text-align: middle-center; }

.book-card {
    flex-direction: row;
    align-items: flex-start;
    padding: 14px 16px;
    margin-bottom: 10px;
    border-radius: 14px;
    background-color: var(--card);
    border-width: 1px;
    border-color: var(--line);
}
.book-card__icon { width: 28px; height: 28px; color: var(--jade); margin: 2px 14px 0 0; }
.book-card__body { flex-grow: 1; flex-shrink: 1; }
.book-card__title { font-size: 19px; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.book-card__meta { font-size: 12px; color: var(--muted); margin-bottom: 4px; }
.book-card__text { font-size: 14px; margin: 4px 0; }
.book-card__actions { flex-direction: row; align-items: center; margin-left: 12px; flex-shrink: 0; }
.book-card__actions > * { margin-left: 6px; }
.narrow .book-card { flex-wrap: wrap; }
.narrow .book-card__actions { margin: 8px 0 0 0; }
.link-list { max-height: 360px; overflow: hidden; }

.reader { flex-grow: 1; }
.reader__bar {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    background-color: var(--card);
    border-bottom-width: 1px;
    border-color: var(--line);
}
.reader__page { height: 34px; padding: 0 12px; border-radius: 8px; }
.reader__page:hover { background-color: var(--jade-wash); }
.reader__page-label { font-size: 14px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.reader__banner { flex-direction: row; align-items: center; padding: 8px 14px; background-color: var(--gold-wash); }
.reader__banner-text { font-size: 13px; flex-shrink: 1; }
.reader__search { padding: 10px 14px; background-color: var(--paper); border-bottom-width: 1px; border-color: var(--line); max-height: 45%; }
.reader__results { max-height: 260px; margin-top: 6px; }
.search-hit { flex-direction: row; align-items: flex-start; padding: 6px 8px; border-radius: 8px; }
.search-hit:hover { background-color: var(--jade-wash); }
.search-hit__page { font-size: 13px; width: 56px; flex-shrink: 0; color: var(--jade-deep); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.search-hit__text { font-size: 13px; flex-shrink: 1; color: var(--muted); }
.reader__scroll { flex-grow: 1; background-color: rgb(214, 207, 195); }
.reader__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { align-items: center; padding: 12px 0 32px 0; }
.reader__sheet { background-color: rgb(255, 255, 255); -unity-background-scale-mode: stretch-to-fill; }
.reader__status { font-size: 14px; color: var(--muted); margin-top: 12px; -unity-text-align: middle-center; }
.offset__value { font-size: 18px; margin: 10px 0; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.offset__row { flex-direction: row; align-items: center; margin-bottom: 12px; }
.offset__row > * { margin-right: 8px; }

/* ---------- Búsqueda y ajustes ---------- */
.setting-toggle { margin: 10px 0 2px 0; }
.setting-toggle > Label { font-size: 16px; min-width: 260px; color: var(--ink); }
.setting-slider { margin: 12px 0 4px 0; max-width: 520px; }
.setting-slider > Label { font-size: 16px; min-width: 160px; color: var(--ink); }
.setting-help { font-size: 14px; color: var(--muted); margin: 4px 0 10px 0; max-width: 720px; }
.setting-help--warn { color: var(--cinnabar); }
.unity-toggle__checkmark { width: 22px; height: 22px; border-radius: 6px; border-color: var(--line); background-color: var(--card); }
.unity-toggle:checked .unity-toggle__checkmark { background-color: var(--jade); border-color: var(--jade); }

.plans { flex-direction: row; flex-wrap: wrap; margin: 8px -8px 16px -8px; }
.plan { flex-grow: 1; flex-basis: 260px; margin: 8px; padding: 20px; border-radius: 18px; background-color: var(--card); border-width: 1px; border-color: var(--line); }
.plan--premium { border-color: var(--gold); border-width: 2px; }
.plan__crown { color: var(--gold); width: 28px; height: 28px; }
.plan__name { font-size: 26px; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.plan__price { font-size: 16px; color: var(--muted); margin-bottom: 10px; }
.plan__line { font-size: 14px; margin: 3px 0; }

/* ---------- Diálogos y avisos ---------- */
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
.overlay__scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(20, 18, 16, 0.45); }
.dialog {
    width: 92%;
    max-width: 520px;
    max-height: 88%;
    padding: 22px 24px;
    border-radius: 20px;
    background-color: var(--card);
    -unity-font-definition: resource("UI/Fonts/Outfit-Regular");
    color: var(--ink);
}
.dialog__title { font-size: 26px; margin-bottom: 8px; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.dialog__subtitle { font-size: 13px; color: var(--muted); letter-spacing: 0.8px; margin: 14px 0 6px 0; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.dialog__text { font-size: 15px; color: var(--ink); margin-bottom: 8px; }
.dialog__body { flex-shrink: 1; overflow: hidden; }
.dialog__body > .btn { margin-top: 8px; align-self: flex-start; }
.dialog__body > .option { margin-bottom: 6px; }
.dialog__buttons { flex-direction: row; align-items: center; margin-top: 16px; }
.dialog__buttons .btn { margin-left: 8px; }

.toasts { position: absolute; left: 0; right: 0; bottom: 84px; align-items: center; }
.toast {
    padding: 10px 18px;
    margin-top: 8px;
    max-width: 520px;
    border-radius: 20px;
    background-color: rgba(36, 42, 51, 0.94);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("UI/Fonts/Outfit-Regular");
    transition-property: opacity;
    transition-duration: 0.35s;
}
.toast--out { opacity: 0; }
.wide .toasts { bottom: 28px; }

.taiji-mark { width: 32px; height: 32px; }

/* ---------- Desafíos: estrellas, sellos, nivel ---------- */
.stars { flex-direction: row; align-items: center; margin: 4px 0; }
.stars .icon { width: 18px; height: 18px; margin-right: 2px; --icon-stroke: 1.6; }
.stars--small .icon { width: 14px; height: 14px; }
.stars--big { margin: 10px 0 6px 0; }
.stars--big .icon { width: 42px; height: 42px; margin: 0 5px; }
.star--on { color: var(--gold); }
.star--off { color: var(--line); }

.seal {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    rotate: -6deg;
    flex-shrink: 0;
}
.seal--on { background-color: var(--cinnabar); border-color: rgba(255, 255, 255, 0.55); }
.seal--off { background-color: rgba(0, 0, 0, 0); border-color: var(--line); }
.seal__hanzi { font-size: 17px; color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.seal--off .seal__hanzi { color: var(--line); }
.seal--tiny { width: 26px; height: 26px; border-radius: 5px; margin-left: 5px; }
.seal--tiny .seal__hanzi { font-size: 10px; }
.seal--big { width: 104px; height: 104px; border-radius: 16px; border-width: 4px; }
.seal--big .seal__hanzi { font-size: 38px; }
.seal--hero { width: 66px; height: 66px; border-radius: 12px; margin-right: 18px; border-color: rgba(255, 255, 255, 0.85); }
.seal--hero .seal__hanzi { font-size: 24px; }

.xp-chip { flex-direction: row; align-items: center; padding: 3px 10px 3px 6px; margin-left: 8px; border-radius: 12px; background-color: var(--gold-wash); }
.xp-chip .icon { width: 16px; height: 16px; color: var(--gold); }
.xp-chip__text { font-size: 13px; margin-left: 4px; color: var(--gold-text); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.xp-chip--big { padding: 7px 16px 7px 10px; margin: 4px; border-radius: 20px; }
.xp-chip--big .icon { width: 22px; height: 22px; }
.xp-chip--big .xp-chip__text { font-size: 19px; }
.combo-chip { flex-direction: row; align-items: center; padding: 3px 10px 3px 6px; margin-left: 8px; border-radius: 12px; background-color: rgba(181, 82, 59, 0.1); }
.combo-chip .icon { width: 16px; height: 16px; color: var(--cinnabar); }
.combo-chip__text { font-size: 13px; margin-left: 4px; color: var(--cinnabar); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.combo-chip--hot { background-color: var(--cinnabar); }
.combo-chip--hot .icon, .combo-chip--hot .combo-chip__text { color: rgb(255, 255, 255); }

.level-card { flex-direction: row; align-items: center; padding: 16px 20px; margin: 4px 0 14px 0; border-radius: 18px; background-color: var(--night); }
.level-card__badge {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: var(--gold);
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    flex-shrink: 0;
}
.level-card__number { font-size: 26px; color: rgb(255, 255, 255); -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.level-card__caption { font-size: 10px; color: rgba(255, 255, 255, 0.85); letter-spacing: 1px; margin-top: -4px; }
.level-card__body { flex-grow: 1; flex-shrink: 1; }
.level-card__head { flex-direction: row; align-items: center; }
.level-card__title { font-size: 26px; color: rgb(250, 246, 236); -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.level-card__bar { height: 10px; border-radius: 5px; margin: 8px 0 6px 0; background-color: rgba(255, 255, 255, 0.14); }
.level-card__meta { font-size: 12px; color: rgba(250, 246, 236, 0.65); }
.level-card__side { margin-left: 22px; align-items: flex-end; flex-shrink: 0; }
.level-card__stat { flex-direction: row; align-items: center; }
.level-card__stat .icon { width: 20px; height: 20px; }
.level-card__stat-text { font-size: 17px; margin-left: 6px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.level-card__seals { flex-direction: row; margin-top: 8px; }
.level-card .xp-chip { background-color: rgba(201, 154, 46, 0.24); }
.level-card .xp-chip__text { color: rgb(240, 205, 120); }
.level-card .seal--off { border-color: rgba(255, 255, 255, 0.25); }
.level-card .seal--off .seal__hanzi { color: rgba(255, 255, 255, 0.3); }
.narrow .level-card { flex-wrap: wrap; padding: 14px 16px; }
.narrow .level-card__badge { width: 52px; height: 52px; margin-right: 12px; }
.narrow .level-card__title { font-size: 22px; }
.narrow .level-card__side { flex-direction: row; justify-content: space-between; align-items: center; width: 100%; margin: 10px 0 0 0; }
.narrow .level-card__seals { margin-top: 0; }

/* ---------- Mapa de desafíos ---------- */
.axis-hero__facts { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.axis-hero__fact { flex-direction: row; align-items: center; padding: 3px 10px 3px 6px; margin: 0 8px 4px 0; border-radius: 12px; background-color: rgba(255, 255, 255, 0.16); }
.axis-hero__fact .icon { width: 16px; height: 16px; color: rgb(255, 255, 255); }
.axis-hero__fact-text { font-size: 13px; margin-left: 5px; color: rgb(255, 255, 255); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }

.practice-card__row { flex-direction: row; align-items: center; }
.practice-card__emblem { width: 54px; height: 54px; border-radius: 27px; align-items: center; justify-content: center; margin-right: 16px; flex-shrink: 0; }
.practice-card__emblem .icon { width: 30px; height: 30px; color: rgb(255, 255, 255); --icon-stroke: 2; }
.practice-card__body { flex-grow: 1; flex-shrink: 1; }
.practice-card__side { align-items: flex-end; margin-left: 16px; flex-shrink: 0; }
.practice-card__side .btn { margin-top: 6px; }
.narrow .practice-card__row { flex-direction: column; align-items: stretch; }
.narrow .practice-card__emblem { display: none; }
.narrow .practice-card__side { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; margin: 10px 0 0 0; }

.cmap { padding: 4px 0 24px 0; }
.cmap__unit { flex-direction: row; align-items: center; padding: 8px 14px; margin: 18px 0 6px 0; border-radius: 12px; background-color: var(--night); }
.cmap__unit-title { font-size: 14px; letter-spacing: 0.6px; color: rgb(250, 246, 236); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); flex-shrink: 1; }
.cmap__unit-meta { font-size: 13px; color: rgba(250, 246, 236, 0.7); margin-left: 10px; }
.cmap__row { flex-direction: row; align-items: center; min-height: 86px; padding: 6px 0; }
.cmap__lead { flex-shrink: 0; }
.cmap__label {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 10px 14px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--card);
}
.cmap__row:hover .cmap__label { border-color: rgb(205, 192, 170); }
.cmap__title-row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.cmap__title { font-size: 16px; flex-shrink: 1; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.cmap__next { margin: 0 0 0 8px; padding: 2px 8px; }
.cmap__meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
.cmap__hanzi { font-size: 20px; color: var(--muted); margin-left: 12px; flex-shrink: 0; }
.cmap__row--unit .cmap__label { background-color: var(--gold-wash); border-color: rgba(201, 154, 46, 0.35); }
.cmap__row--axis .cmap__label { background-color: rgba(181, 82, 59, 0.08); border-color: rgba(181, 82, 59, 0.3); }
.cmap__row--axis .cmap__title { font-size: 18px; }
.narrow .cmap__hanzi { display: none; }

.cnode { width: 60px; height: 60px; margin-right: 14px; flex-shrink: 0; align-items: center; justify-content: center; }
.cnode__face {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    border-width: 3px;
    border-color: var(--line);
    background-color: var(--card);
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-back;
}
.cmap__row:hover .cnode__face { scale: 1.1 1.1; }
.cnode__face .icon { width: 26px; height: 26px; color: var(--muted); --icon-stroke: 2.2; }
.cnode__number { font-size: 21px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.cnode--passed .cnode__face { border-color: rgba(255, 255, 255, 0.9); }
.cnode--passed .cnode__face .icon { color: rgb(255, 255, 255); }
.cnode--locked .cnode__face { background-color: rgb(236, 230, 219); }
.cnode--boss { width: 70px; height: 70px; }
.cnode--boss .cnode__face { width: 66px; height: 66px; border-radius: 20px; border-width: 3px; }
.cnode--boss .cnode__face .icon { width: 32px; height: 32px; }
.cnode--exam { width: 84px; height: 84px; }
.cnode--exam .cnode__face { width: 80px; height: 80px; border-radius: 40px; border-width: 4px; }
.cnode--exam .cnode__face .icon { width: 40px; height: 40px; }
.cnode__halo {
    position: absolute;
    left: -2px;
    top: -2px;
    right: -2px;
    bottom: -2px;
    border-radius: 32px;
    border-width: 3px;
    opacity: 0.75;
    transition-property: scale, opacity;
    transition-duration: 0.9s;
    transition-timing-function: ease-in-out-sine;
}
.cnode__halo--big { scale: 1.4 1.4; opacity: 0; }
.cnode--boss .cnode__halo { border-radius: 22px; }
.cnode--exam .cnode__halo { border-radius: 44px; }

.ctrack { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 8px 0 0 0; }
.ctrack__dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--line);
    background-color: var(--card);
    margin: 2px 5px 2px 0;
    transition-property: scale;
    transition-duration: 0.35s;
}
.ctrack__dot--unit { width: 16px; height: 16px; border-radius: 4px; }
.ctrack__dot--axis { width: 18px; height: 18px; border-radius: 9px; border-width: 3px; }
.ctrack__dot--locked { background-color: var(--line); }
.ctrack__dot--passed { border-width: 0; }
.ctrack__dot--beat { scale: 1.45 1.45; }

/* ---------- Portada, ejercicio y resultado de un desafío ---------- */
.challenge-intro { align-items: center; align-self: center; width: 100%; max-width: 640px; padding-top: 12px; }
.challenge-intro__emblem {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.6);
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
}
.challenge-intro__emblem .icon { width: 52px; height: 52px; color: rgb(255, 255, 255); }
.challenge-intro__eyebrow { font-size: 13px; letter-spacing: 0.8px; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.challenge-intro__title { font-size: 34px; margin: 4px 0 6px 0; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/CormorantGaramond-SemiBold"); }
.challenge-intro__text { font-size: 15px; color: var(--muted); max-width: 560px; -unity-text-align: middle-center; }
.challenge-intro__chips { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 10px; }
.challenge-intro__chips .pill { margin: 4px; }
.challenge-intro__rewards { width: 100%; padding: 12px 16px; margin: 8px 0 10px 0; border-radius: 14px; background-color: var(--gold-wash); }
.challenge-intro__subtitle { font-size: 12px; letter-spacing: 0.8px; color: var(--gold-text); margin-bottom: 4px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.challenge-intro__line { font-size: 14px; margin: 2px 0; }
.challenge-intro .setting-toggle { align-self: center; }
.challenge-intro .callout { width: 100%; }
.btn--big { height: 52px; padding: 0 30px; border-radius: 26px; }
.btn--big .icon-btn__label { font-size: 17px; }

.challenge-run__eyebrow { flex-direction: row; align-items: center; }
.challenge-run__eyebrow .icon { width: 16px; height: 16px; margin-right: 6px; }
.run-dots { flex-direction: row; margin: 4px 0 14px 0; }
.run-dot { flex-grow: 1; height: 8px; margin-right: 5px; border-radius: 4px; background-color: var(--line); transition-property: background-color, scale; transition-duration: 0.25s; }
.run-dot--current { background-color: var(--gold); }
.run-dot--right { background-color: var(--ok); }
.run-dot--wrong { background-color: var(--bad); }
.timer { height: 22px; margin-bottom: 14px; border-radius: 11px; overflow: hidden; justify-content: center; background-color: var(--line-soft); }
.timer__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; border-radius: 11px; opacity: 0.35; }
.timer__label { font-size: 12px; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.timer--low { background-color: rgba(178, 58, 72, 0.2); }
.timer--low .timer__label { color: var(--bad); }

.match__cols { flex-direction: row; align-items: flex-start; margin-top: 10px; }
.match__col { flex-grow: 1; flex-basis: 0; margin-right: 10px; }
.match__item { min-height: 58px; }
.match__hanzi { font-size: 22px; margin-right: 10px; color: var(--ink); }
.match__pinyin { font-size: 15px; color: var(--muted); -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.narrow .match__hanzi { font-size: 18px; margin-right: 6px; }

.result__gains { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; margin: 4px 0 10px 0; }
.result__gains .combo-chip { padding: 7px 16px 7px 10px; margin: 4px; border-radius: 20px; }
.result__level { width: 100%; max-width: 420px; padding: 12px 16px; margin: 6px 0; border-radius: 14px; border-width: 1px; border-color: var(--line); background-color: var(--card); }
.result__level-title { font-size: 15px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.result__level-bar { height: 10px; border-radius: 5px; margin: 8px 0 6px 0; }
.result__seal { margin: 12px 0 4px 0; }
.pill--level { padding: 6px 14px; font-size: 14px; background-color: var(--night); color: rgb(255, 255, 255); }
.weak { width: 100%; max-width: 520px; margin-top: 14px; }
.weak__title { font-size: 13px; letter-spacing: 1px; color: var(--muted); margin-bottom: 6px; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.weak__item { flex-direction: row; align-items: center; padding: 10px 14px; margin: 0 0 6px 0; border-radius: 12px; border-width: 1px; border-color: var(--line); background-color: var(--card); }
.weak__item:hover { background-color: var(--jade-wash); }
.weak__item .icon { width: 18px; height: 18px; margin-right: 10px; }
.weak__text { font-size: 15px; flex-grow: 1; flex-shrink: 1; -unity-text-align: middle-left; }
.weak__chevron { color: var(--muted); }

.continue__head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.continue__emblem {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    flex-shrink: 0;
    transition-property: scale;
    transition-duration: 0.55s;
    transition-timing-function: ease-in-out-sine;
}
.continue__emblem--beat { scale: 1.1 1.1; }
.continue__emblem .icon { width: 24px; height: 24px; color: rgb(255, 255, 255); }
.continue__head-text { flex-grow: 1; flex-shrink: 1; }

.seals-card { border-left-color: var(--cinnabar); }
.seals-card__row { flex-direction: row; flex-wrap: wrap; margin: 8px 0 10px 0; }
.seals-card__item { width: 33%; align-items: center; padding: 6px 4px; }
.seals-card .seal { width: 54px; height: 54px; border-radius: 10px; }
.seals-card .seal__hanzi { font-size: 19px; }
.seals-card__label { font-size: 12px; margin-top: 10px; -unity-text-align: middle-center; -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold"); }
.seals-card__meta { font-size: 11px; color: var(--muted); -unity-text-align: middle-center; }

.float-text {
    position: absolute;
    right: 0;
    top: -6px;
    font-size: 15px;
    -unity-font-definition: resource("UI/Fonts/Outfit-SemiBold");
    transition-property: translate, opacity;
    transition-duration: 1.1s;
    transition-timing-function: ease-out-cubic;
}
.float-text--up { translate: 0 -36px; opacity: 0; }
.float-text--xp { color: var(--gold-text); }
.float-text--combo { right: 140px; font-size: 18px; color: var(--cinnabar); }

/* ---------- Animaciones (Anim.cs): al final para ganar a las reglas anteriores ---------- */
.anim {
    transition-property: opacity, translate, scale;
    transition-duration: 0.45s, 0.45s, 0.35s;
    transition-timing-function: ease-out-cubic, ease-out-cubic, ease-out-back;
}
.anim--in { opacity: 0; translate: 0 14px; }
.anim--zero { opacity: 0; scale: 0.2 0.2; }
.anim--pop { scale: 1.12 1.12; }

/* ---------- Tamaño del texto ---------- */
.text-large .paragraph, .text-large .bullet__text, .text-large .callout__text, .text-large .option__text, .text-large .tour__text, .text-large .detail__text { font-size: 18px; }
.text-large .summary__text, .text-large .quote__text { font-size: 20px; }
.text-xlarge .paragraph, .text-xlarge .bullet__text, .text-xlarge .callout__text, .text-xlarge .option__text, .text-xlarge .tour__text, .text-xlarge .detail__text { font-size: 20px; }
.text-xlarge .summary__text, .text-xlarge .quote__text { font-size: 22px; }
.text-small .paragraph, .text-small .bullet__text, .text-small .callout__text, .text-small .option__text { font-size: 14px; }
