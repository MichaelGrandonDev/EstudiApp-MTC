<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compila los .cs del dominio de Unity (sin motor) con .NET y los prueba con xUnit. -->
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>EstudiApp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../EstudiAppMTC/Assets/_Project/Scripts/Domain/**/*.cs" Link="Domain/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../EstudiAppMTC/Assets/StreamingAssets/content/curriculum.json" Link="curriculum.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

</Project>
